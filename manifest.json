{
  "schemaVersion": 1,
  "id": "echo.model",
  "name": "Echo",
  "version": "1.0.0",
  "author": "Echo (fork of hermes.openrouter by Sven Radetzky)",
  "license": "MIT",
  "description": "Echo usage, DeepSeek balance, and a model switcher — remote via the Echo usage bridge (192.168.2.41:8643).",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Echo",
    "description": "Echo usage, DeepSeek balance, and a model selector fed by the remote usage bridge.",
    "category": "AI",
    "aliases": [
      "echo",
      "deepseek",
      "model",
      "usage"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "connectionMode": "local",
      "bridgeUrl": "",
      "balanceVisible": true,
      "tokensByDayVisible": true,
      "modelUsageVisible": true,
      "providerAccordionVisible": true,
      "recentSessionsVisible": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 300
      }
    ]
  }
}
